# Environment Configuration
# Copy this to .env and update values for production

# JWT Configuration
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# API Configuration
API_HOST=127.0.0.1
API_PORT=8000
ENVIRONMENT=development

# CORS Configuration
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://localhost:3000

# Database Configuration
DATABASE_URL=sqlite:///./fitai_professional.db

# Security
PASSWORD_MIN_LENGTH=8
